{{!
    @template assignfeedback_annotateed/editor

    The AnnotateEd editor as a React component.

    Context variables required for this template:
    * propsjson - The props of the editor as JSON: text and categories.

    Example context (json):
    {
        "propsjson": "{\"text\": \"Ein kurzer Text.\", \"categories\": []}"
    }
}}
{{#react}}
{
    "component": "@moodle/lms/assignfeedback_annotateed/Editor",
    "props": {{{propsjson}}}
}
{{/react}}